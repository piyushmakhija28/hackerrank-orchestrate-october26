        <!-- Canvas Header -->
        <mxCell id="hdr" value="&lt;b&gt;Ghost Data Still Exists — UML 2.5.1 State Machine Architecture&lt;/b&gt;&lt;br&gt;Deletion Request Lifecycle | Concurrent Circuit Breaker States | Poset DAG Step Transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;fontSize=18;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1900" height="60" as="geometry" />
        </mxCell>

        <!-- ============================================== -->
