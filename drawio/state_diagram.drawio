        <mxCell id="s_polchk" value="&lt;b&gt;POLICY_EVALUATING&lt;/b&gt;&lt;hr&gt;do / match deletion_rules.csv&lt;br&gt;do / check statutory exceptions&lt;br&gt;exit / classify residual violations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e40af;fontSize=10;" vertex="1" parent="s_auth_comp">
          <mxGeometry x="990" y="45" width="190" height="85" as="geometry" />
        </mxCell>

        <!-- Verdict Branching in Composite State -->
        <mxCell id="s_incomp" value="&lt;b&gt;INCOMPLETE_SYNTHESIS&lt;/b&gt;&lt;hr&gt;Phase 1: Generate FINDING steps&lt;br&gt;Phase 2: Generate REMEDIATION steps&lt;br&gt;Phase 3: Generate POST-VERIFICATION steps&lt;br&gt;exit / Poset DAG injective 5-tuple sort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="s_auth_comp">
          <mxGeometry x="150" y="190" width="380" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s_comp" value="&lt;b&gt;COMPLETE_SYNTHESIS&lt;/b&gt;&lt;hr&gt;Phase 3: Generate VERIFICATION steps only&lt;br&gt;entry / cite participant evidence_id&lt;br&gt;exit / Poset DAG injective 5-tuple sort" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=11;" vertex="1" parent="s_auth_comp">
          <mxGeometry x="680" y="190" width="380" height="90" as="geometry" />
