        <mxCell id="s_sanitize" value="&lt;b&gt;SANITIZING_INPUT&lt;/b&gt;&lt;hr&gt;entry / compute Shannon H&lt;br&gt;do / strip prompt injection&lt;br&gt;exit / verify safe payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="grp_case_fsm">
