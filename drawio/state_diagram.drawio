        </mxCell>

        <mxCell id="cb_half" value="&lt;b&gt;HALF_OPEN&lt;/b&gt;&lt;br&gt;(Canary Trial Probe)&lt;hr&gt;Permit exactly 1 trial execution&lt;br&gt;Evaluate probe health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=11;" vertex="1" parent="grp_cb_fsm">
