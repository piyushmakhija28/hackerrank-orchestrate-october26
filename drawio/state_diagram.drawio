        </mxCell>

        <mxCell id="cb_open" value="&lt;b&gt;OPEN&lt;/b&gt;&lt;br&gt;(Tripped / Fast-Fail)&lt;hr&gt;Calls immediately rejected&lt;br&gt;Wait for recovery_timeout (30s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=11;" vertex="1" parent="grp_cb_fsm">
