        <mxCell id="st_t4" edge="1" source="st_ver" target="st_sort" parent="grp_step_fsm" style="endArrow=block;strokeColor=#0f172a;strokeWidth=1.2;"><mxGeometry relative="1" as="geometry" /></mxCell>

