          <mxGeometry x="40" y="70" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s_ingest" value="&lt;b&gt;INGESTED&lt;/b&gt;&lt;hr&gt;entry / parse CSV row&lt;br&gt;do / validate schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#0f172a;fontSize=11;" vertex="1" parent="grp_case_fsm">
