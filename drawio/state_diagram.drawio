        <mxCell id="cbt4" value="trial call FAILED" edge="1" source="cb_half" target="cb_open" parent="grp_cb_fsm" style="endArrow=block;strokeColor=#e11d48;strokeWidth=1.5;fontSize=10;"><mxGeometry relative="1" as="geometry" /></mxCell>

