        <mxCell id="st_find" value="&lt;b&gt;PHASE: FINDING&lt;/b&gt;&lt;br&gt;state = PRESENT / ACTIVE&lt;br&gt;evidence_id = file_id / activity_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=10;" vertex="1" parent="grp_step_fsm">
