        <mxCell id="s_witness" value="&lt;b&gt;WITNESS_GROUNDING&lt;/b&gt;&lt;hr&gt;do / assert evidence in manifest &amp;amp; T &amp;lt;= audit_at&lt;br&gt;exit / assert P(Hallucination) == 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="s_auth_comp">
          <mxGeometry x="400" y="320" width="400" height="60" as="geometry" />
