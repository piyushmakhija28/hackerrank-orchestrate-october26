        </mxCell>

        <mxCell id="cb_closed" value="&lt;b&gt;CLOSED&lt;/b&gt;&lt;br&gt;(Healthy / Normal Execution)&lt;hr&gt;failure_count = 0&lt;br&gt;All calls permitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=11;" vertex="1" parent="grp_cb_fsm">
