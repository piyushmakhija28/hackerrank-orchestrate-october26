        </mxCell>

        <mxCell id="s_idres" value="&lt;b&gt;IDENTITY_RESOLVING&lt;/b&gt;&lt;hr&gt;entry / seed with email&lt;br&gt;do / DSU find canonical root&lt;br&gt;do / query orbit cache O(alpha(N))&lt;br&gt;exit / return transitive cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e40af;fontSize=10;" vertex="1" parent="s_auth_comp">
          <mxGeometry x="30" y="45" width="200" height="85" as="geometry" />
        </mxCell>

        <mxCell id="s_evid" value="&lt;b&gt;EVIDENCE_SCANNING&lt;/b&gt;&lt;hr&gt;do / query SQLite memory DBs&lt;br&gt;do / inverted hash token match&lt;br&gt;exit / enforce T(e) &amp;lt;= audit_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e40af;fontSize=10;" vertex="1" parent="s_auth_comp">
          <mxGeometry x="270" y="45" width="200" height="85" as="geometry" />
        </mxCell>

        <mxCell id="s_lin" value="&lt;b&gt;LINEAGE_TRACING&lt;/b&gt;&lt;hr&gt;do / O(log K) bisect window scan&lt;br&gt;do / query activities_by_token&lt;br&gt;exit / flag CDC sync &amp; restore hazards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e40af;fontSize=10;" vertex="1" parent="s_auth_comp">
