        <mxCell id="cbt1" value="failures &gt;= threshold (5)" edge="1" source="cb_closed" target="cb_open" parent="grp_cb_fsm" style="endArrow=block;strokeColor=#e11d48;strokeWidth=1.5;fontSize=10;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cbt2" value="timeout &gt;= 30s expired" edge="1" source="cb_open" target="cb_half" parent="grp_cb_fsm" style="endArrow=block;strokeColor=#d97706;strokeWidth=1.5;fontSize=10;"><mxGeometry relative="1" as="geometry" /></mxCell>
