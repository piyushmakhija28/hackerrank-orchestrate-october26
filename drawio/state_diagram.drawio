        <mxCell id="grp_cb_fsm" value="2. Concurrent Circuit Breaker State Machine" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;fontColor=#581c87;fontSize=14;fontStyle=1;startSize=30;" vertex="1" parent="1">
