        </mxCell>

        <mxCell id="s_knap" value="&lt;b&gt;CONTEXT_OPTIMIZATION&lt;/b&gt;&lt;hr&gt;do / pack 4096-token knapsack&lt;br&gt;do / BPE SHA-256 fact dedup&lt;br&gt;exit / save 19,332 tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=10;" vertex="1" parent="s_auth_comp">
          <mxGeometry x="760" y="45" width="200" height="85" as="geometry" />
