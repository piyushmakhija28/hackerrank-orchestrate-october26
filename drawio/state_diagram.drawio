        </mxCell>

        <!-- Branch: NOT_APPLICABLE -->
        <mxCell id="s_na" value="&lt;b&gt;NOT_APPLICABLE&lt;/b&gt;&lt;hr&gt;entry / set status = NOT_APPLICABLE&lt;br&gt;do / set steps_json = '[]'&lt;br&gt;exit / record telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#065f46;fontSize=11;" vertex="1" parent="grp_case_fsm">
          <mxGeometry x="930" y="55" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Authorized Composite State -->
