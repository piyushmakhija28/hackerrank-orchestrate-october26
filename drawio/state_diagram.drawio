        <mxCell id="s_intent" value="&lt;b&gt;INTENT_AUDIT&lt;/b&gt;&lt;hr&gt;do / scan 30+ non-erasure phrases&lt;br&gt;exit / decide legal authorization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=11;" vertex="1" parent="grp_case_fsm">
