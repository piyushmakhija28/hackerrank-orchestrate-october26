        <mxCell id="grp_step_fsm" value="3. Atomic Audit Step Lifecycle State Machine" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=14;fontStyle=1;startSize=30;" vertex="1" parent="1">
